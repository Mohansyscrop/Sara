/* ==========================================================================
   SARA'S BOUTIQUE — LUXURY INDIAN ETHNIC COUTURE
   Optimized Production Stylesheet (2026 Edition)
   ========================================================================== */

/* ── Root Design Tokens ── */
:root {
    --primary-purple: #3B005A;
    --dark-purple: #240038;
    --plum-dark: #190123;

    --gold: #D4AF37;
    --gold-light: #FFF1C5;
    --gold-dark: #B8860B;
    --gold-hover: #f3d79b;
    --gold-accent: #9c731a;

    --bg-ivory: #fbf6f0;
    --bg-white: #ffffff;
    --cream: #F5E6C8;
    --nav-text: #EDE2F5;
    --text-muted: rgba(245, 235, 250, 0.7);

    --heading-font: "Playfair Display", Georgia, serif;
    --body-font: "Poppins", sans-serif;
    --sans-font: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
    --script-font: "Caveat", cursive;
}

/* ── Global Resets & Body ── */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: auto;
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
    scrollbar-width: thin;
    scrollbar-color: #d4af37 #170024;
}

/* ── Luxury Theme Scrollbar ── */
::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

::-webkit-scrollbar-track {
    background: #170024;
    border-left: 1px solid rgba(212, 175, 55, 0.18);
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #f5d77f 0%, #d4af37 40%, #b8860b 80%, #8c6209 100%);
    border-radius: 10px;
    border: 2px solid #170024;
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.5);
    transition: background 0.3s ease, box-shadow 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #fff3cd 0%, #f5d77f 45%, #d4af37 100%);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.65), inset 0 0 3px rgba(0, 0, 0, 0.3);
}

::-webkit-scrollbar-corner {
    background: #170024;
}

body {
    font-family: var(--body-font);
    background-color: var(--dark-purple);
    color: var(--cream);
    width: 100%;
    max-width: 100%;
    min-height: 100vh;
    position: relative;
}

img, svg, video, canvas, audio, iframe, embed, object {
    max-width: 100%;
    height: auto;
}

/* ==========================================================================
   0. LUXURY TOP SMALL HEADER / PRE-HEADER UTILITY BAR
   ========================================================================== */
.luxury-top-bar {
    background: linear-gradient(90deg, #0e0015 0%, #1b0028 25%, #250036 50%, #1b0028 75%, #0e0015 100%);
    border-bottom: 1px solid rgba(212, 175, 55, 0.26);
    color: rgba(245, 235, 252, 0.9);
    font-family: var(--sans-font);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    padding: 0.35rem 0;
    position: relative;
    z-index: 1035;
    transition: all 0.3s ease;
}

.luxury-top-bar a {
    color: rgba(245, 235, 252, 0.88);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
}

.luxury-top-bar a:hover {
    color: var(--gold-light, #FFF1C5) !important;
}

.luxury-top-bar a:hover i {
    color: var(--gold-hover, #f3d79b) !important;
}

.top-bar-divider {
    color: rgba(212, 175, 55, 0.35);
    font-size: 0.72rem;
    user-select: none;
}

.top-bar-announcement {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.76rem;
    color: rgba(255, 250, 245, 0.92);
    letter-spacing: 0.025em;
}

.announcement-highlight {
    color: var(--gold);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
}

.announcement-text {
    color: rgba(255, 250, 245, 0.88);
    font-weight: 400;
}

.gold-sparkle {
    display: inline-flex;
    color: var(--gold);
    animation: topGoldShimmer 2.2s infinite ease-in-out;
}

@keyframes topGoldShimmer {
    0%, 100% {
        opacity: 0.85;
        transform: scale(1);
        filter: drop-shadow(0 0 2px rgba(212, 175, 55, 0.4));
    }
    50% {
        opacity: 1;
        transform: scale(1.18);
        filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.9));
    }
}

.top-bar-badge,
.top-bar-location,
.top-bar-currency {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    color: rgba(245, 235, 252, 0.88);
}

.top-bar-currency {
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.35);
    padding: 1px 8px;
    border-radius: 12px;
    font-weight: 600;
    color: var(--gold-light);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 2px;
}

@media (max-width: 767.98px) {
    .luxury-top-bar {
        font-size: 0.71rem;
        padding: 0.28rem 0;
    }
    .top-bar-announcement {
        font-size: 0.71rem;
        gap: 4px;
    }
    .announcement-highlight {
        font-size: 0.68rem;
    }
}

/* ==========================================================================
   1. LUXURY HEADER & STICKY NAVIGATION
   ========================================================================== */
.luxury-header {
    background: linear-gradient(90deg, #180026 0%, #29003f 20%, #350050 50%, #27003c 80%, #170024 100%);
    border-bottom: 1.5px solid rgba(212, 175, 55, 0.4);
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.55);
    position: sticky;
    top: 0;
    z-index: 1030;
    padding: 0.55rem 0;
    transition: all 0.3s ease;
    padding: 0;
}

.brand-container {
    display: flex;
    align-items: center;
    text-decoration: none;
    user-select: none;
}

.brand-logo-img {
    height: 84px;
    max-height: 90px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.5));
}

@media (max-width: 992px) {
    .brand-logo-img { height: 64px; }
}

@media (max-width: 576px) {
    .brand-logo-img { height: 52px; }
}

.nav-luxury-links {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.2rem;
}

@media (max-width: 1240px) and (min-width: 992px) {
    .nav-luxury-links {
        gap: 1.25rem;
    }
    .nav-luxury-link {
        font-size: 0.88rem !important;
        letter-spacing: 0.01em !important;
    }
    .brand-logo-img {
        height: 70px;
    }
}

.nav-luxury-link {
    font-family: var(--body-font);
    font-size: 0.98rem;
    font-weight: 400;
    color: var(--nav-text);
    text-decoration: none;
    position: relative;
    padding: 6px 0;
    transition: color 0.2s ease;
    letter-spacing: 0.02em;
}

.nav-luxury-link:hover {
    color: var(--gold);
}

.nav-luxury-link.active {
    color: #ffffff;
    font-weight: 500;
}

.nav-luxury-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    box-shadow: 0 0 6px rgba(212, 175, 55, 0.6);
}

.nav-luxury-link:not(.active)::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transition: width 0.25s ease;
}

.nav-luxury-link:not(.active):hover::after {
    width: 100%;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.action-icon-btn {
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    color: #F8F4EC;
    font-size: 1.05rem;
    position: relative;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0;
    text-decoration: none;
}

.action-icon-btn i {
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, color 0.25s ease;
}

.action-icon-btn:hover {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.25) 0%, rgba(229, 195, 120, 0.12) 100%);
    color: var(--gold);
    border-color: rgba(212, 175, 55, 0.65);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35), 0 0 10px rgba(212, 175, 55, 0.2), inset 0 1px 2px rgba(255, 255, 255, 0.2);
}

.action-icon-btn:hover i {
    transform: scale(1.1);
    color: #FFE58F;
}

.action-icon-btn:active {
    transform: translateY(0) scale(0.96);
    box-shadow: 0 2px 6px rgba(212, 175, 55, 0.25);
}

.badge-cart-gold {
    position: absolute;
    top: -3px;
    right: -3px;
    background: radial-gradient(circle at 30% 30%, #FFEFA6, var(--gold), var(--gold-dark));
    color: var(--dark-purple);
    font-weight: 700;
    font-size: 0.65rem;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    border: 1.5px solid var(--dark-purple);
}

.luxury-toggler {
    border: 1px solid rgba(212, 175, 55, 0.28);
    background: rgba(212, 175, 55, 0.08);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    padding: 0;
    transition: all 0.25s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
}

.luxury-toggler:hover {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.25) 0%, rgba(229, 195, 120, 0.12) 100%);
    color: #FFE58F;
    border-color: rgba(212, 175, 55, 0.65);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35);
}

.luxury-toggler:focus {
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.45);
    outline: none;
}

.offcanvas-luxury {
    background: linear-gradient(180deg, var(--dark-purple) 0%, var(--primary-purple) 100%);
    border-left: 1px solid rgba(212, 175, 55, 0.3);
    color: var(--cream);
}

.search-modal-content {
    background: var(--dark-purple);
    border: 1px solid var(--gold);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    border-radius: 12px;
}

.search-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #fff;
    font-family: var(--body-font);
    border-radius: 30px;
    padding: 12px 20px;
}

.search-input:focus {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--gold);
    color: #fff;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
}

/* ==========================================================================
   2. HERO BANNER SECTION
   ========================================================================== */
.hero-banner-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: clamp(520px, 40vw, 680px);
    background-color: var(--plum-dark);
    background-image:
        linear-gradient(to right,
            #14001c 0%,
            rgba(20, 0, 28, 0.96) 32%,
            rgba(20, 0, 28, 0.72) 52%,
            rgba(20, 0, 28, 0) 72%),
        url('../img/bn1.png');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding: 3.5rem 0 2.2rem;
    overflow: hidden;
}

.hero-banner-wrapper {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    min-height: 100%;
    width: 100%;
    max-width: 100%;
}

.hero-banner-content {
    max-width: 600px;
    width: 100%;
    z-index: 2;
}

.hero-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(229, 195, 120, 0.12);
    border: 1px solid rgba(229, 195, 120, 0.35);
    color: var(--gold);
    font-family: var(--sans-font);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 30px;
    margin-bottom: 0.9rem;
    backdrop-filter: blur(4px);
}

.hero-tag-pill i { color: #ffda79; }

.hero-main-title {
    font-family: var(--heading-font);
    font-size: clamp(2.3rem, 4.2vw, 3.8rem);
    line-height: 1.05;
    color: #fff;
    font-weight: 400;
    margin-bottom: 1rem;
}

.title-italic-gold {
    font-style: italic;
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    color: var(--gold);
    display: inline-block;
    background: linear-gradient(
    90deg,
    #9B6B16 0%,
    #D99B2B 18%,
    #FFE9A0 38%,
    #F4C95D 50%,
    #FFF1B2 62%,
    #D89A28 80%,
    #9A6915 100%
  );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-desc {
    font-family: var(--sans-font);
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-weight: 300;
    max-width: 520px;
}

.hero-meta-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans-font);
    font-size: 0.8rem;
    color: rgba(245, 235, 250, 0.85);
    margin-bottom: 1.5rem;
}

.hero-meta-strip .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

.hero-meta-strip .meta-dot { color: var(--gold); }
.text-gold { color: var(--gold) !important; }

.hero-btn-group { margin-bottom: 2rem; }

.hero-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--gold);
    color: #1a0026;
    font-family: var(--sans-font);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 10px 24px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(229, 195, 120, 0.35);
}

.hero-shop-btn:hover {
    background: var(--gold-hover);
    color: #0d0014;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(229, 195, 120, 0.5);
}

.hero-outline-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(229, 195, 120, 0.4);
    font-family: var(--sans-font);
    font-weight: 500;
    font-size: 0.88rem;
    padding: 10px 22px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
}

.hero-outline-btn:hover {
    background: rgba(229, 195, 120, 0.15);
    border-color: var(--gold);
    color: var(--gold);
    transform: translateY(-2px);
}

.hero-features-bar {
    background: transparent;
    border-top: 1px solid rgba(229, 195, 120, 0.2);
    border-bottom: none;
    padding-top: 1.4rem;
    width: 100%;
    max-width: 100%;
}

.hero-features-group {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
}

.feature-divider {
    width: 1px;
    height: 24px;
    background: rgba(229, 195, 120, 0.25);
    flex-shrink: 0;
}

.feature-icon-svg {
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
}

.feature-text {
    display: flex;
    flex-direction: column;
}

.feature-title {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.2;
}

.feature-subtitle {
    font-family: var(--sans-font);
    font-size: 0.69rem;
    color: var(--text-muted);
    line-height: 1.2;
    margin-top: 2px;
}

.hero-slider-nav {
    position: absolute;
    right: 1rem;
    bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--gold);
    z-index: 3;
}

.slider-counter {
    font-family: var(--sans-font);
    font-size: 0.85rem;
    margin-right: 6px;
    letter-spacing: 0.05em;
    font-weight: 500;
}

.nav-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(229, 195, 120, 0.45);
    background: rgba(25, 1, 35, 0.5);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
}

.nav-arrow:hover {
    background: rgba(229, 195, 120, 0.25);
    border-color: var(--gold);
    transform: scale(1.06);
}

@media (max-width: 992px) {
    .hero-banner-section {
        min-height: 480px;
        background-image:
            linear-gradient(to right,
                rgba(20, 0, 28, 0.98) 0%,
                rgba(20, 0, 28, 0.9) 45%,
                rgba(20, 0, 28, 0.3) 100%),
            url('../img/bn1.png');
    }
}

@media (max-width: 768px) {
    .hero-banner-section {
        background-position: left;
        padding: 3rem 0 2rem;
    }
    .hero-slider-nav { display: none; }
    .hero-features-group {
        flex-wrap: wrap;
        gap: 1rem 1.4rem;
    }
    .feature-divider { display: none; }
}

